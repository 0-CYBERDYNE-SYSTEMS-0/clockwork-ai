    "ics",
    "clockwork",
    "ai-agent"
  ],
  "author": "FarmFriend Labs",
  "license": "MIT",
  "dependencies": {
    "@clockwork-ai/core": "*",
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  }
}
