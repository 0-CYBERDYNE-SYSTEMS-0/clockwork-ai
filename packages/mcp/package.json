{
  "name": "@clockwork-ai/mcp",
  "version": "0.2.0",
  "description": "MCP server for Clockwork — expose calendar reasoning tools to AI agents",
  "main": "dist/index.js",
  "bin": {
    "clockwork-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
